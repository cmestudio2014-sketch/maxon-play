<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://maxonplay.app/tizen" version="1.0.0" viewmodes="maximized">
    <tizen:application id="MxnPlay001.MaxonPlay" package="MxnPlay001" required_version="4.0"/>
    <name>MAXON PLAY</name>
    <description>Player para listas autorizadas pelo usuario. Nao contem canais.</description>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <!-- Ajuste para o domínio real da API (Square Cloud) -->
    <access origin="https://maxonplay.squareweb.app" subdomains="true"/>
    <access origin="*" subdomains="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="enable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>
</widget>