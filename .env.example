# ===== MAXON PLAY — variáveis de ambiente =====
# Copie para a aba "Variáveis de ambiente" da Square Cloud (ou .env local). Nunca faça commit do .env real.

# --- Obrigatórias em produção ---
NODE_ENV=production
APP_URL=https://maxonplay.squareweb.app
# PostgreSQL externo (Neon, Supabase, Railway, ElephantSQL, VPS...). Plano gratuito funciona.
DATABASE_URL=postgres://usuario:senha@host:5432/maxonplay?sslmode=require
# Gere com: openssl rand -hex 32   (cada um diferente!)
JWT_SECRET=troque-por-64-caracteres-aleatorios
CONFIG_ENCRYPTION_KEY=troque-por-outros-64-caracteres-aleatorios

# --- Primeiro administrador (criado no 1º boot somente se não existir admin) ---
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Administrador

# --- Opcionais ---
# Número de vendas (só dígitos, com DDI). Também editável em Painel > Configurações.
WHATSAPP_NUMBER=
# Origens permitidas para a API dos apps (vírgula). "*" libera todos (apps de TV não usam origem).
CORS_ORIGINS=*
# SSL do banco: auto (padrão), true ou false
DATABASE_SSL=
DATABASE_POOL_MAX=5
# Dados fictícios de demonstração (não use em produção)
SEED_DEMO=false
# Libera a tela "criar primeiro admin" em produção (deixe false; prefira ADMIN_EMAIL/ADMIN_PASSWORD)
ALLOW_SETUP=false
# Porta/host (Square Cloud usa 80; já é o padrão do start)
PORT=80
HOST=0.0.0.0
# Força novo build no start (true após atualizar o código)
FORCE_BUILD=false